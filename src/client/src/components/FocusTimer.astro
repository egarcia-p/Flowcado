<div class="focus-timer">
  <h1>Focus Timer</h1>
  <p id="timer-display">25:00</p>
  <button id="start-btn">Start</button>
  <button id="pause-btn" disabled>Pause</button>
</div>
<script define:vars={{ initialTimeMinutes: 25 }}>
  const timerDisplay = document.getElementById('timer-display');
  const startButton = document.getElementById('start-btn');
  const pauseButton = document.getElementById('pause-btn');
  let timeInSeconds = initialTimeMinutes * 60;
  let intervalId = null;
  let startTime = null;

  function formatTime(seconds) {
    const minutes = Math.floor(seconds / 60);
    const secondsRemaining = seconds % 60;
    return `${String(minutes).padStart(2, '0')}:${String(secondsRemaining).padStart(2, '0')}`;
  }

  timerDisplay.textContent = formatTime(timeInSeconds);

  function startTimer() {
    if (intervalId) return; // Already running
    
    if (!startTime) {
      startTime = new Date();
    }
    
    startButton.disabled = true;
    startButton.textContent = "Running...";
    pauseButton.disabled = false;

    intervalId = setInterval(() => {
      timeInSeconds--;
      timerDisplay.textContent = formatTime(timeInSeconds);

      if (timeInSeconds <= 0) {
        clearInterval(intervalId);
        intervalId = null;
        startButton.disabled = false;
        startButton.textContent = "Reset";
        pauseButton.disabled = true;
        
        // Log session completion via API
        const endTime = new Date();
        const durationMinutes = Math.round((endTime - startTime) / 60000); // Duration in minutes
        fetch('/api/session', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ 
            start_time: startTime.toISOString(), 
            end_time: endTime.toISOString(), 
            total_duration_minutes: durationMinutes,
            status: 'completed'
          })
        });
      }
    }, 1000);
  }

  function pauseTimer() {
    if (!intervalId) return;
    clearInterval(intervalId);
    intervalId = null;
    startButton.disabled = false;
    startButton.textContent = "Resume";
    pauseButton.disabled = true;
  }

  function resetTimer() {
    timeInSeconds = initialTimeMinutes * 60;
    startTime = null;
    timerDisplay.textContent = formatTime(timeInSeconds);
    startButton.textContent = "Start";
    pauseButton.disabled = true;
  }

  startButton.addEventListener('click', () => {
    if (startButton.textContent === "Reset") {
      resetTimer();
    } else {
      startTimer();
    }
  });
  pauseButton.addEventListener('click', pauseTimer);
</script>