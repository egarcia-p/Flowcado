<div class="focus-timer-card">
  <div class="timer-display-container">
    <div class="timer-glow"></div>
    <span id="timer-display">25:00</span>
  </div>
  <div class="timer-controls">
    <button id="start-btn" class="control-btn primary">Start</button>
    <button id="pause-btn" class="control-btn secondary" disabled>Pause</button>
  </div>
</div>
<script define:vars={{ initialTimeMinutes: 25 }}>
  const timerDisplay = document.getElementById("timer-display");
  const startButton = document.getElementById("start-btn");
  const pauseButton = document.getElementById("pause-btn");

  const TOTAL_MS = initialTimeMinutes * 60 * 1000;

  // --- State ---
  let intervalId = null;
  let sessionStartTime = null; // Wall-clock time when the user first pressed Start
  let endTime = null;          // Absolute timestamp when the timer should reach zero
  let remainingMs = TOTAL_MS;  // Tracks remaining time while paused

  // --- Helpers ---
  function formatTime(ms) {
    const totalSeconds = Math.max(0, Math.ceil(ms / 1000));
    const minutes = Math.floor(totalSeconds / 60);
    const seconds = totalSeconds % 60;
    return `${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")}`;
  }

  function updateDisplay() {
    if (endTime !== null) {
      // Running: derive remaining time from the real clock
      timerDisplay.textContent = formatTime(endTime - Date.now());
    } else {
      // Paused or not started: show stored remaining time
      timerDisplay.textContent = formatTime(remainingMs);
    }
  }

  // Initial display
  updateDisplay();

  // --- Core tick ---
  function tick() {
    const remaining = endTime - Date.now();
    timerDisplay.textContent = formatTime(remaining);

    if (remaining <= 0) {
      // Timer finished
      clearInterval(intervalId);
      intervalId = null;
      endTime = null;
      remainingMs = 0;

      timerDisplay.textContent = "00:00";
      startButton.disabled = false;
      startButton.textContent = "Reset";
      pauseButton.disabled = true;

      // Log completed session
      const now = new Date();
      fetch("/api/session", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          start_time: sessionStartTime.toISOString(),
          end_time: now.toISOString(),
          total_duration_minutes: initialTimeMinutes,
          status: "completed",
        }),
      }).then(() => {
        window.dispatchEvent(new CustomEvent("session-logged"));
      });
    }
  }

  // --- Controls ---
  function startTimer() {
    if (intervalId) return; // Already running

    if (!sessionStartTime) {
      sessionStartTime = new Date(); // Record wall-clock session start
    }

    // Set the absolute end time from now + however much is left
    endTime = Date.now() + remainingMs;

    startButton.disabled = true;
    startButton.textContent = "Running...";
    pauseButton.disabled = false;

    // Tick every 250ms: cheap enough to recover quickly after tab throttling
    intervalId = setInterval(tick, 250);
    tick(); // Run immediately so display updates without 250ms delay
  }

  function pauseTimer() {
    if (!intervalId) return;

    // Snapshot remaining time from the real clock before stopping
    remainingMs = Math.max(0, endTime - Date.now());
    endTime = null;

    clearInterval(intervalId);
    intervalId = null;

    updateDisplay();
    startButton.disabled = false;
    startButton.textContent = "Resume";
    pauseButton.disabled = true;
  }

  function resetTimer() {
    if (intervalId) {
      clearInterval(intervalId);
      intervalId = null;
    }
    sessionStartTime = null;
    endTime = null;
    remainingMs = TOTAL_MS;

    updateDisplay();
    startButton.disabled = false;
    startButton.textContent = "Start";
    pauseButton.disabled = true;
  }

  // --- Page Visibility API ---
  // When the tab comes back into focus, force an immediate display update
  // so the user never sees a stale (throttled) value.
  document.addEventListener("visibilitychange", () => {
    if (!document.hidden && intervalId) {
      updateDisplay();
    }
  });

  // --- Event listeners ---
  startButton.addEventListener("click", () => {
    if (startButton.textContent === "Reset") {
      resetTimer();
    } else {
      startTimer();
    }
  });
  pauseButton.addEventListener("click", pauseTimer);
</script>

<style>
  .focus-timer-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    box-shadow: var(--card-shadow);
    border-radius: 24px;
    padding: 2.5rem 2rem;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    backdrop-filter: blur(12px);
  }

  .timer-display-container {
    position: relative;
    width: 220px;
    height: 220px;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 50%;
    border: 3px solid var(--border-color);
    background: rgba(10, 10, 10, 0.4);
  }

  .timer-glow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border-radius: 50%;
    box-shadow: inset 0 0 25px var(--accent-glow);
    pointer-events: none;
  }

  #timer-display {
    font-size: 3.5rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--text-primary);
    text-shadow: 0 0 10px var(--accent-glow);
    letter-spacing: -0.02em;
  }

  .timer-controls {
    display: flex;
    gap: 1rem;
    width: 100%;
  }

  .control-btn {
    flex: 1;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 600;
    padding: 0.8rem 1.5rem;
    border-radius: 12px;
    border: none;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .control-btn.primary {
    background-color: var(--accent);
    color: #05070a;
  }

  .control-btn.primary:hover:not(:disabled) {
    background-color: #a3e635;
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(132, 204, 22, 0.4);
  }

  .control-btn.secondary {
    background-color: #21262d;
    color: var(--text-primary);
    border: 1px solid var(--border-color);
  }

  .control-btn.secondary:hover:not(:disabled) {
    background-color: #30363d;
    transform: translateY(-2px);
  }

  .control-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
    transform: none !important;
    box-shadow: none !important;
  }
</style>
