<div class="contribution-card">
  <div class="contribution-header">
    <h3 class="contribution-title">Monthly Activity</h3>
    <div class="month-nav">
      <button id="prev-month-btn" class="nav-btn" aria-label="Previous Month">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
          <path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z"/>
        </svg>
      </button>
      <span id="current-month-display" class="month-display">June 2026</span>
      <button id="next-month-btn" class="nav-btn" aria-label="Next Month">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
          <path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z"/>
        </svg>
      </button>
    </div>
  </div>

  <div class="grid-wrapper">
    <div class="grid-labels">
      <span class="label-empty"></span>
      <span>Mon</span>
      <span class="label-empty"></span>
      <span>Wed</span>
      <span class="label-empty"></span>
      <span>Fri</span>
      <span class="label-empty"></span>
    </div>
    <div id="contribution-grid-body" class="grid-body">
      <!-- Grid cells will be dynamically injected here -->
    </div>
  </div>

  <div class="contribution-footer">
    <div id="monthly-total" class="monthly-total">
      Total: 0 sessions
    </div>
    <div class="contribution-legend">
      <span>Less</span>
      <div class="legend-cells">
        <div class="legend-cell level-0"></div>
        <div class="legend-cell level-1"></div>
        <div class="legend-cell level-2"></div>
        <div class="legend-cell level-3"></div>
        <div class="legend-cell level-4"></div>
      </div>
      <span>More</span>
    </div>
  </div>
</div>

<script>
  let sessions = [];
  // Initialize with current date
  let selectedDate = new Date();

  const prevMonthBtn = document.getElementById('prev-month-btn');
  const nextMonthBtn = document.getElementById('next-month-btn');
  const currentMonthDisplay = document.getElementById('current-month-display');
  const gridBody = document.getElementById('contribution-grid-body');
  const monthlyTotalEl = document.getElementById('monthly-total');

  const monthNames = [
    "January", "February", "March", "April", "May", "June",
    "July", "August", "September", "October", "November", "December"
  ];

  async function fetchSessions() {
    try {
      const response = await fetch('/api/sessions');
      if (!response.ok) throw new Error('Failed to fetch sessions');
      sessions = await response.json();
      render();
    } catch (err) {
      console.error('Error fetching sessions for contribution grid:', err);
    }
  }

  function getSessionCountsByDate() {
    const counts = {};
    sessions.forEach(session => {
      if (!session.end_time) return;
      const date = new Date(session.end_time);
      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, '0');
      const day = String(date.getDate()).padStart(2, '0');
      const dateKey = `${year}-${month}-${day}`;
      
      counts[dateKey] = (counts[dateKey] || 0) + 1;
    });
    return counts;
  }

  function getLevel(count) {
    if (count === 0) return 0;
    if (count === 1) return 1;
    if (count === 2) return 2;
    if (count === 3) return 3;
    return 4;
  }

  function render() {
    const year = selectedDate.getFullYear();
    const month = selectedDate.getMonth();

    // Update Header
    currentMonthDisplay.textContent = `${monthNames[month]} ${year}`;

    // Clear Grid
    gridBody.innerHTML = '';

    // Calculate dates
    const firstDay = new Date(year, month, 1);
    const lastDay = new Date(year, month + 1, 0);

    const startOffset = firstDay.getDay(); // 0 is Sunday, 6 is Saturday
    const startDate = new Date(year, month, 1 - startOffset);

    const endOffset = 6 - lastDay.getDay();
    const endDate = new Date(year, month + 1, endOffset);

    const sessionCounts = getSessionCountsByDate();
    let totalSessionsThisMonth = 0;

    // Generate grid items
    const tempDate = new Date(startDate);
    while (tempDate <= endDate) {
      const isCurrentMonth = tempDate.getMonth() === month;
      
      const cell = document.createElement('div');
      cell.className = 'grid-cell';

      if (isCurrentMonth) {
        const y = tempDate.getFullYear();
        const m = String(tempDate.getMonth() + 1).padStart(2, '0');
        const d = String(tempDate.getDate()).padStart(2, '0');
        const dateKey = `${y}-${m}-${d}`;
        const count = sessionCounts[dateKey] || 0;
        
        totalSessionsThisMonth += count;
        
        const level = getLevel(count);
        cell.classList.add(`level-${level}`);
        
        // Tooltip text formatting
        const formattedDate = tempDate.toLocaleDateString(undefined, { 
          weekday: 'short', 
          year: 'numeric', 
          month: 'short', 
          day: 'numeric' 
        });
        const sessionText = count === 1 ? '1 session' : `${count} sessions`;
        cell.setAttribute('data-tooltip', `${sessionText} on ${formattedDate}`);
      } else {
        cell.classList.add('other-month');
      }

      gridBody.appendChild(cell);
      tempDate.setDate(tempDate.getDate() + 1);
    }

    // Update total sessions counter
    monthlyTotalEl.textContent = `Total: ${totalSessionsThisMonth} session${totalSessionsThisMonth !== 1 ? 's' : ''}`;
  }

  prevMonthBtn.addEventListener('click', () => {
    selectedDate.setMonth(selectedDate.getMonth() - 1);
    render();
  });

  nextMonthBtn.addEventListener('click', () => {
    selectedDate.setMonth(selectedDate.getMonth() + 1);
    render();
  });

  // Initial fetch and render
  fetchSessions();
  
  // Re-fetch sessions when a new session is logged (listen to custom/timer updates if any, or poll periodically)
  // For simplicity, we can also refresh metrics when user interacts or just on load.
  // We can listen to a custom event if we fire one from FocusTimer.astro
  window.addEventListener('session-logged', () => {
    fetchSessions();
  });
</script>

