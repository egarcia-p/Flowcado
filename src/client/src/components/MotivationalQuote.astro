---
import fs from 'fs';
import path from 'path';

// Read quotes from JSON file
const quotesPath = path.join(process.cwd(), 'public/quotes.json');
const quotesData = fs.readFileSync(quotesPath, 'utf-8');
const quotes = JSON.parse(quotesData);

// Select quote based on current day
const now = new Date();
const dayIndex = Math.floor(Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()) / (1000 * 60 * 60 * 24));
const dailyQuote = quotes.length > 0 ? quotes[((dayIndex % quotes.length) + quotes.length) % quotes.length] : { text: 'Could not retrieve a quote of the day', author: 'Flowcado' };
---

<section class="quote-section">
  <blockquote class="quote-text" id="quote-text">
    "{dailyQuote.text}"
  </blockquote>
  <p class="quote-author" id="quote-author">— {dailyQuote.author}</p>
</section>

<script define:vars={{ quotes }}>
  function updateDailyQuote() {
    const quoteTextEl = document.getElementById('quote-text');
    const quoteAuthorEl = document.getElementById('quote-author');
    if (!quoteTextEl || !quoteAuthorEl || !quotes || quotes.length === 0) return;

    const now = new Date();
    const dayIndex = Math.floor(Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()) / (1000 * 60 * 60 * 24));
    const quote = quotes[((dayIndex % quotes.length) + quotes.length) % quotes.length];

    quoteTextEl.textContent = `"${quote.text}"`;
    quoteAuthorEl.textContent = `— ${quote.author}`;
  }

  updateDailyQuote();
</script>

<style>
  .quote-section {
    background: linear-gradient(135deg, rgba(132, 204, 22, 0.1) 0%, rgba(132, 204, 22, 0.05) 100%);
    border: 1px solid rgba(132, 204, 22, 0.2);
    border-radius: 12px;
    padding: 24px;
    margin: 24px 0;
    text-align: center;
    backdrop-filter: blur(10px);
  }

  .quote-text {
    font-size: 1.2rem;
    font-weight: 500;
    color: #f0f6fc;
    line-height: 1.6;
    margin-bottom: 12px;
    font-style: italic;
    letter-spacing: 0.3px;
  }

  .quote-author {
    font-size: 0.95rem;
    color: #8b949e;
    margin: 0;
    font-weight: 400;
  }

  @media (max-width: 768px) {
    .quote-section {
      padding: 16px;
      margin: 16px 0;
    }

    .quote-text {
      font-size: 1rem;
    }

    .quote-author {
      font-size: 0.85rem;
    }
  }
</style>
