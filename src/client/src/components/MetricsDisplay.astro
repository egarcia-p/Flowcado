<div class="metrics-card">
  <h3 class="metrics-title">Your Flow State</h3>
  <div class="metrics-grid">
    <div class="metric-item">
      <span class="metric-label">Weekly Sessions</span>
      <span id="total-sessions" class="metric-val">0</span>
    </div>
    <div class="metric-item">
      <span class="metric-label">Current Streak</span>
      <span id="current-streak" class="metric-val">0 days</span>
    </div>
    <div class="metric-item">
      <span class="metric-label">Weekly Average</span>
      <span id="weekly-average" class="metric-val">N/A</span>
    </div>
  </div>
</div>

<script define:vars={{ apiUrl: '/api/sessions' }}>
  const totalSessionsEl = document.getElementById('total-sessions');
  const currentStreakEl = document.getElementById('current-streak');
  const weeklyAverageEl = document.getElementById('weekly-average');

  async function fetchMetrics() {
    try {
      const response = await fetch(apiUrl);
      if (!response.ok) throw new Error('Failed to fetch session data.');
      const sessions = await response.json();

      // --- Metric Calculation Logic ---
      const now = new Date();
      const startOfWeek = new Date(now);
      startOfWeek.setDate(now.getDate() - now.getDay()); // Go back to Sunday
      startOfWeek.setHours(0, 0, 0, 0);
      const weeklySessions = sessions.filter(session => new Date(session.end_time) >= startOfWeek);
      let totalCount = weeklySessions.length;
      totalSessionsEl.textContent = totalCount;

      // Simple streak calculation (requires sorting and date comparison)
      if (sessions.length > 0) {
        // Sort by end_time descending to check recent activity first
        const sortedSessions = [...sessions].sort((a, b) => new Date(b.end_time) - new Date(a.end_time));
        let streakCount = 0;
        let lastDate = null;

        for (const session of sortedSessions) {
          const currentDate = new Date(session.end_time);
          // Check if the current date is exactly one day after the previous logged session's end date
          if (!lastDate || (currentDate.getTime() === lastDate.getTime() + (24 * 60 * 60 * 1000))) {
            streakCount++;
            lastDate = currentDate;
          } else if (currentDate < lastDate) {
             // If the session is older than the previous one, it breaks the streak check for this simple model.
          }
        }
        currentStreakEl.textContent = `${streakCount} day${streakCount !== 1 ? 's' : ''}`;

        // Simple weekly average
        const totalDurationMinutes = weeklySessions.reduce((sum, session) => sum + session.total_duration_minutes, 0);
        const avgPerSession = totalCount > 0 ? Math.round(totalDurationMinutes / totalCount) : 0;
        weeklyAverageEl.textContent = `${avgPerSession} minutes`;

      } else {
        currentStreakEl.textContent = '0 days';
        weeklyAverageEl.textContent = 'N/A';
      }

    } catch (error) {
      console.error("Error fetching metrics:", error);
      totalSessionsEl.textContent = 'Error';
    }
  }

  fetchMetrics();
  window.addEventListener('session-logged', fetchMetrics);
</script>

<style>
  .metrics-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    box-shadow: var(--card-shadow);
    border-radius: 24px;
    padding: 1.75rem;
    width: 100%;
    backdrop-filter: blur(12px);
  }

  .metrics-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-align: center;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 0.5rem;
    background: rgba(10, 10, 10, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.02);
    border-radius: 14px;
  }

  .metric-label {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-align: center;
  }

  .metric-val {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  #total-sessions.metric-val {
    color: var(--accent);
    text-shadow: 0 0 10px var(--accent-glow);
  }
</style>