---
import FocusTimer from '../components/FocusTimer.astro';
import MetricsDisplay from '../components/MetricsDisplay.astro';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Flowcado - Focus Timer</title>
    <!-- Assuming Tailwind CSS is configured globally -->
  </head>
  <body>
    <main class="container mx-auto p-4">
      <h1 class="text-3xl font-bold mb-6 text-center">Welcome to Flowcado</h1>

      <!-- Focus Timer Component -->
      <FocusTimer />

      <div class="my-12 border-t pt-8"></div>

      <!-- Metrics Display Component -->
      <MetricsDisplay />
    </main>
  </body>
</html>